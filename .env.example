# Database Configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Server and authentication
PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Phone OTP via MSG91
MSG91_AUTHKEY=your_msg91_authkey
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
# Comma-separated E.164 phone and test-code pairs, e.g. 919876543210:123456
OTP_TEST_PHONES=
# Test phones are disabled in production unless explicitly set to true.
ALLOW_OTP_TEST_PHONES=false

# AWS S3 Configuration (credentials come from EC2 instance role / default chain)
AWS_REGION=ap-southeast-2
S3_BUCKET=casting-app-s3
# S3_KEY_PREFIX=casting/
# S3_SIGNED_URL_TTL=3600
# MAX_IMAGE_MB=10
# MAX_VIDEO_MB=500
# CLOUDFRONT_DOMAIN=d1234abcdef.cloudfront.net

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Password reset email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Casting <no-reply@your-verified-domain.com>"
BACKEND_URL=https://your-backend.example.com
FRONTEND_URL=https://your-frontend.example.com
APP_DEEP_LINK_SCHEME=casting
PASSWORD_RESET_ONELINK_URL=https://treeko.onelink.me/CEaN
PASSWORD_RESET_DEV_MODE=false

# Face verification
FACE_ENCRYPTION_KEYS={"1":"<base64-encoded-32-byte-key>"}
FACE_ENCRYPTION_KEY_VERSION=1
FACE_EMBEDDING_LENGTH=512
FACE_DISTANCE_THRESHOLD=0.6
