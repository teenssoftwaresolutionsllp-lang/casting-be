# Database Configuration
# Example only: DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Server Configuration
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# CORS Configuration (comma-separated origins; required in production, wildcard disallowed)
# ALLOWED_ORIGINS=https://app.treeko.com,https://support.treeko.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Firebase Admin Configuration (For Google OAuth Sign-In)
# Either place firebase-service-account.json in root or set the credentials below:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=service-account@example.invalid
FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/firebase-service-account.json
# FIREBASE_PRIVATE_KEY=<multiline-private-key-placeholder>
